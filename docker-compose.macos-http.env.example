# macOS host-side runtime environment for the HTTP service
# Copy this file to docker-compose.macos-http.env and fill in real values on the host machine.

# Use one authentication method. API key is preferred when available.
BGG_API_KEY=
BGG_COOKIE=

# Required for personalized tools and resources.
BGG_USERNAME=

# Optional. Override when the service is accessed via a LAN or VPN address.
MCP_BASE_URL=http://localhost:8080
