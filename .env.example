# BGG MCP 环境变量模板
# 复制此文件为 .env 并填写你的实际信息

# ========================================
# Cookie 认证方式（临时测试）
# ========================================
# 格式: bggusername=用户名; bggpassword=加密密码; SessionID=会话ID
# 注意: 用分号和空格分隔，用引号包裹

BGG_COOKIE="bggusername=你的用户名; bggpassword=你的加密密码; SessionID=你的会话ID"

# ========================================
# API Key 认证方式（推荐长期使用）
# ========================================
# 如果你有 BGG API Key，使用这个代替 Cookie
# 申请地址: https://boardgamegeek.com/applications

# BGG_API_KEY="your_api_key_here"

# ========================================
# 用户名（两种方式都需要）
# ========================================

BGG_USERNAME="你的BGG用户名"

# ========================================
# 获取 Cookie 的步骤
# ========================================
# 1. 登录 https://boardgamegeek.com/
# 2. 按 F12 打开开发者工具
# 3. Application → Cookies → boardgamegeek.com
# 4. 复制以下三个值:
#    - bggusername (你的用户名)
#    - bggpassword (很长的加密字符串)
#    - SessionID (会话ID)
# 5. 格式: "bggusername=值; bggpassword=值; SessionID=值"
# 6. 用引号包裹，用分号和空格分隔
